# Public build-time switches only; never put API tokens in VITE_* variables.
# Project e1din49w / production is fixed in shared/sanityConfig.js.
# No environment file is needed for the default local portfolio.
VITE_CONTENT_SOURCE=local

# Optional per-section overrides (local or sanity). Unset inherits the global switch.
# VITE_RESEARCH_SOURCE=local
# VITE_PUBLICATIONS_SOURCE=local
# VITE_TYPEFACES_SOURCE=local
# VITE_ABOUT_SOURCE=local

# Optional CDN override. Default: off in development, on in production builds.
# VITE_SANITY_USE_CDN=false
# VITE_CMS_MOCK_TESTS is reserved for dedicated localhost test servers.
